{
  "name": "dsh-session-observer",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "A conversation view for DeepSeek Harness that answers one question: do I need to step in? Rule-based by default, zero model calls.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anilams/dsh-session-observer.git"
  },
  "homepage": "https://github.com/Anilams/dsh-session-observer#readme",
  "bugs": {
    "url": "https://github.com/Anilams/dsh-session-observer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-observability",
    "conversation-view"
  ]
}
